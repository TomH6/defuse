{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "state": {
          ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid)"
        },
        "inputs": {
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && root.child('rooms').child($code).child('state').child('hostId').val() === auth.uid))"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "defuse": {
      "days": {
        "$date": {
          "scores": {
            ".read": true,
            ".indexOn": ["k"],
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists()",
              ".validate": "newData.hasChildren(['name','t','won','k']) && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('t').isNumber() && newData.child('t').val() >= 1000 && newData.child('t').val() <= 121000"
            }
          }
        }
      },
      "groups": {
        "$gid": {
          ".read": true,
          "info": {
            ".write": "auth != null && !data.exists()"
          },
          "members": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20)"
            }
          }
        }
      }
    }
  }
}
